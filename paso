def agregar_resultado(path, tipo, dato):
    if not os.path.exists(path):
        cargar_json(path)

    with open(path, "r") as f:
        try:
            data = json.load(f)
        except:
            data = {}

    if tipo not in data:
        data[tipo] = []

    data[tipo].append(dato)

    with open(path, "w") as f:
        json.dump(data, f, indent=4)
